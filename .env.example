# Local demo values only. Replace these before any shared or deployed environment.
POSTGRES_DB=agentops
POSTGRES_USER=agentops
POSTGRES_PASSWORD=local_dev_only_change_before_deploy
API_PORT=8200
DATABASE_URL=postgresql://agentops:local_dev_only_change_before_deploy@db:5432/agentops

# Optional Stage 6 AI review through your separately running RelayGuard / Gateway LLM.
# From Docker Desktop on macOS, host.docker.internal reaches a service exposed on the Mac.
RELAYGUARD_BASE_URL=http://host.docker.internal:8100
RELAYGUARD_API_KEY=
RELAYGUARD_TIMEOUT_SECONDS=60
AGENTOPS_TENANT_ID=acme
AGENTOPS_USER_ID=agentops-demo
# RelayGuard owns model choice and backup configuration; this class selects its routing policy.
AGENTOPS_TASK_CLASS=complex
